{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep OSS",
          "semanticVersion": "1.85.0",
          "rules": [
            {
              "id": "python.flask.security.injection.tainted-sql-string.tainted-sql-string",
              "shortDescription": { "text": "User data flows into a SQL string" },
              "help": { "text": "Use parameterised queries." },
              "helpUri": "https://semgrep.dev/r/python.flask.security.injection.tainted-sql-string.tainted-sql-string",
              "properties": { "tags": ["security", "CWE-89", "OWASP-A03"], "security-severity": "8.0", "precision": "high" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "python.flask.security.injection.tainted-sql-string.tainted-sql-string",
          "level": "error",
          "message": { "text": "Detected user input used to build a SQL string in get_payment()." },
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "app/api/handlers.py" }, "region": { "startLine": 12, "endLine": 12 } } }],
          "partialFingerprints": { "primaryLocationLineHash": "a1b2c3" }
        }
      ]
    }
  ]
}
